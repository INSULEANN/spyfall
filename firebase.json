{
  "hosting": [
    {
      "site": "boardgametbaan",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/pics/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        },
        {
          "source": "/cards/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "site": "spyfall-3a10a",
      "public": "dist",
      "ignore": [
        "**"
      ],
      "redirects": [
        {
          "regex": "^/(?P<rest>.*)$",
          "destination": "https://boardgametbaan.web.app/:rest",
          "type": 301
        }
      ]
    }
  ],
  "database": {
    "rules": "firebase.rules.json"
  }
}
